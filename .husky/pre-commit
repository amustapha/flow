#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Run Black on staged Python files in backend
STAGED_PYTHON_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep "^backend/.*\.py$" || true)
if [ -n "$STAGED_PYTHON_FILES" ]; then
  echo "Running Black on backend Python files..."
  black --config backend/pyproject.toml $STAGED_PYTHON_FILES
  git add $STAGED_PYTHON_FILES
fi

# Run frontend linting on staged files
cd frontend && npx lint-staged
